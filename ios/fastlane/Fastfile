default_platform(:ios)

platform :ios do
  # Sync splash screen color from AppTheme before build
  private_lane :sync_splash_color do
    UI.message("🎨 Syncing splash screen color from AppTheme...")
    Dir.chdir("../..") do
      Bundler.with_unbundled_env do
        system("dart", "run", "tool/sync_splash_color.dart") || UI.user_error!("Splash color sync failed")
      end
    end
  end

  desc "Run Flutter tests"
  lane :build_test do
    # Run flutter test from the project root
    Dir.chdir("../..") do
      sh("flutter", "test")
    end
  end

  desc "Compile only (No Code Signing)"
  lane :compile do
    sync_splash_color
    Dir.chdir("../..") do
      sh("flutter", "build", "ios", "--release", "--no-codesign")
    end
  end

  desc "Push a new beta build to TestFlight"
  desc "Uses version and build number from pubspec.yaml"
  lane :upload do
    # 1. 讀取 pubspec.yaml 版本資訊 (format: 1.0.0+1)
    pubspec = YAML.load_file("../../pubspec.yaml", aliases: true)
    full_version = pubspec['version']
    version_parts = full_version.split('+')
    version_number = version_parts[0]
    build_number = version_parts[1].to_i

    UI.message("📋 Version from pubspec.yaml: #{version_number}")
    UI.message("📦 Build Number from pubspec.yaml: #{build_number}")

    # 是否為 CI 環境
    is_ci_build = ENV['CI'] == 'true'

    # Setup App Store Connect API Key (用於 upload_to_testflight)
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
      api_key_params = {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        in_house: false
      }
      
      if ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
        api_key_params[:key_content] = ENV["APP_STORE_CONNECT_API_KEY_CONTENT"]
        api_key_params[:is_key_content_base64] = true
      else
        key_path = File.expand_path(ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"], __dir__)
        api_key_params[:key_filepath] = key_path
      end
      
      app_store_connect_api_key(api_key_params)
    end

    # Sync splash screen color before build
    sync_splash_color

    # Sync certificates FIRST (before flutter build)
    match(type: "appstore", readonly: is_ci_build)

    # Build Flutter app (--no-codesign because build_app will handle signing)
    Dir.chdir("../..") do
      Bundler.with_unbundled_env do
        system("flutter", "build", "ios", "--release", "--no-codesign", "--build-name=#{version_number}", "--build-number=#{build_number}") || UI.user_error!("Flutter build failed")
      end
    end
    
    # Build and archive (with code signing)
    build_app(
      workspace: "Runner.xcworkspace", 
      scheme: "Runner",
      export_method: "app-store"
    )
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false
    )

    UI.success("🎉 Successfully uploaded v#{version_number} (#{build_number}) to TestFlight!")

    # Return version info for other lanes to use
    { version: version_number, build_number: build_number }
  end

  desc "Run upload, then tag and push to git"
  lane :release do
    # Call upload lane and get return value
    build_info = upload
    
    # Format: v1.0.1(5)
    tag_name = "v#{build_info[:version]}(#{build_info[:build_number]})"
    
    add_git_tag(tag: tag_name)
    push_to_git_remote
  end
end
