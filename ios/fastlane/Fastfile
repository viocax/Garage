default_platform(:ios)

platform :ios do
  # Sync splash screen color from AppTheme before build
  private_lane :sync_splash_color do
    UI.message("🎨 Syncing splash screen color from AppTheme...")
    Dir.chdir("../..") do
      Bundler.with_unbundled_env do
        system("dart", "run", "tool/sync_splash_color.dart") || UI.user_error!("Splash color sync failed")
      end
    end
  end

  desc "Run Flutter tests"
  lane :build_test do
    # Run flutter test from the project root
    Dir.chdir("../..") do
      sh("flutter", "test")
    end
  end

  desc "Compile only (No Code Signing)"
  lane :compile do
    sync_splash_color
    Dir.chdir("../..") do
      sh("flutter", "build", "ios", "--release", "--no-codesign")
    end
  end

  desc "Push a new beta build to TestFlight"
  desc "Automatically increments build number from TestFlight"
  lane :upload do
    # 1. 讀取 pubspec.yaml 版本號 (aliases: true for YAML anchors support)
    pubspec = YAML.load_file("../../pubspec.yaml", aliases: true)
    version_number = pubspec['version'].split('+').first

    # 是否為 CI 環境
    is_ci_build = ENV['CI'] == 'true'

    # Setup App Store Connect API Key
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
      api_key_params = {
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        in_house: false
      }
      
      if ENV["APP_STORE_CONNECT_API_KEY_KEY_CONTENT"]
        api_key_params[:key_content] = ENV["APP_STORE_CONNECT_API_KEY_KEY_CONTENT"]
      else
        api_key_params[:key_filepath] = ENV["APP_STORE_CONNECT_API_KEY_KEY_FILEPATH"]
      end
      
      app_store_connect_api_key(api_key_params)
    end

    begin
      # 2. 獲取該版本在 TestFlight 上的最新 Build Number
      # 如果沒找到 (新版本)，預設回傳 0，所以 +1 後會變成 1
      current_build_number = app_store_build_number(
        version: version_number,
        initial_build_number: 0,
        live: false
      )
      
      new_build = current_build_number + 1
      UI.message("📦 Version: #{version_number}, New Build Number: #{new_build}")

    rescue => exception
      # 3. 異常處理與錯誤通知
      error_message = "Failed to fetch build number from App Store Connect: #{exception.message}"
      UI.error(error_message)

      # 發送 Email 通知 (需要設定 SMTP 相關環境變數或使用 mailgun 等 plugin)
      # 範例使用 Fastlane 內建 mail action (需設定 MAIL_USERNAME, MAIL_PASSWORD 等)
      # 或者使用類似 notification 服務
      # notification(subtitle: "Build Failed", message: error_message) 

      # 這裡演示如何呼叫 mail (請確保環境變數已設定，否則此行會失敗，建議先註解或自行填入)
      # mail(
      #   to: "drakehuang81@gmail.com",
      #   subject: "Fastlane Build Failed: #{version_number}",
      #   message: "Error fetching build number: #{exception.message}\n\nPlease check App Store Connect status."
      # )

      raise exception
    end

    # Sync splash screen color before build
    sync_splash_color

    # Build Flutter app
    Dir.chdir("../..") do
      Bundler.with_unbundled_env do
        system("flutter", "build", "ios", "--release", "--build-name=#{version_number}", "--build-number=#{new_build}") || UI.user_error!("Flutter build failed")
      end
    end

    # Sync certificates
    match(type: "appstore", readonly: is_ci_build)
    
    # Build and archive
    build_app(
      workspace: "Runner.xcworkspace", 
      scheme: "Runner",
      export_method: "app-store"
    )
    
    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      uses_non_exempt_encryption: false
    )

    # Return version info for other lanes to use
    { version: version_number, build_number: new_build }
  end

  desc "Run upload, then tag and push to git"
  lane :release do
    # Call upload lane and get return value
    build_info = upload
    
    # Format: v1.0.1(5)
    tag_name = "v#{build_info[:version]}(#{build_info[:build_number]})"
    
    add_git_tag(tag: tag_name)
    push_to_git_remote
  end
end
